// -*- mode: jsonc -*-
[
  {
    "output": ["DP-1", "DP-2"],
    "height": 32,
    "spacing": 10,

    "modules-left": [
      "cpu",
      "memory",
      "custom/amd-gpu",
      "custom/amd-vram"
    ],
    "modules-center": [
      "clock"
      
    ],
    "modules-right": [
      "custom/hyprwhspr",
      "pulseaudio",
      "tray"
          ],

    "tray": {
      "icon-size": 14,
      "spacing": 10
    },

    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%I:%M %p  ·  %a %b %d}",
      "format-alt": "{:%Y-%m-%d}"
    },

    "cpu": {
      "format": "CPU {usage}%",
      "states": {
        "critical": 90
      },
      "tooltip": true
    },

    "memory": {
      "format": "RAM {}%",
      "states": {
        "critical": 90
      }
    },

    "pulseaudio": {
      "format": "VOL {volume}%",
      "format-muted": "VOL muted",
      "on-click": "pavucontrol",
      "scroll-step": 5
    },
	"custom/hyprwhspr": {
	  "exec": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh status",
	  "interval": 2,
	  "return-type": "json",
	  "exec-on-event": true,
	  "format": "{}",
	  "on-click": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh toggle",
	  "on-click-right": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh restart",
	  "tooltip": true
	},
	"custom/amd-gpu": {
	  "exec": "~/.config/waybar/scripts/amd-gpu.sh gpu",
	  "return-type": "json",
	  "interval": 2,
	  "format": "{}",
	  "tooltip": true
	},
	"custom/amd-vram": {
	  "exec": "~/.config/waybar/scripts/amd-gpu.sh vram",
	  "return-type": "json",
	  "interval": 2,
	  "format": "{}",
	  "tooltip": true
	}
  }
]
