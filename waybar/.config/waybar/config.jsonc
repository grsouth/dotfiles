// -*- mode: jsonc -*-
[
  {
    "output": ["DP-1", "DP-2"],
    "height": 32,
    "spacing": 10,

    "modules-left": [
      "cpu",
      "memory",
      "custom/amd-gpu",
      "custom/amd-vram"
    ],
    "modules-center": [
      "custom/workspace-group-1",
      "custom/workspace-group-2",
      "custom/workspace-group-3",
      "clock#time",
      "clock#date"
    ],
    "modules-right": [
      "custom/hyprwhspr",
      "custom/notification",
      "pulseaudio",
      "tray"
          ],

    "tray": {
      "icon-size": 14,
      "spacing": 10
    },

    "clock#time": {
      "format": "{:%I:%M %p}",
      "format-alt": "{:%H:%M}"
    },

    "clock#date": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%a %b %d}",
      "format-alt": "{:%Y-%m-%d}"
    },

    "cpu": {
      "format": "CPU {usage}%",
      "states": {
        "critical": 90
      },
      "tooltip": true
    },

    "memory": {
      "format": "RAM {}%",
      "states": {
        "critical": 90
      }
    },

    "pulseaudio": {
      "format": "VOL {volume}%",
      "format-muted": "VOL muted",
      "on-click": "pavucontrol",
      "scroll-step": 5
    },
	"custom/hyprwhspr": {
	  "exec": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh status",
	  "interval": 2,
	  "return-type": "json",
	  "exec-on-event": true,
	  "format": "{}",
	  "on-click": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh toggle",
	  "on-click-right": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh restart",
	  "tooltip": true
	},
	"custom/notification": {
	  "tooltip": true,
	  "format": "{0} {icon}",
	  "format-icons": {
	    "notification": "󱅫",
	    "none": "󰂜",
	    "dnd-notification": "󰂠",
	    "dnd-none": "󰪓",
	    "inhibited-notification": "󰂛",
	    "inhibited-none": "󰪑",
	    "dnd-inhibited-notification": "󰂛",
	    "dnd-inhibited-none": "󰪑"
	  },
	  "return-type": "json",
	  "exec-if": "which swaync-client",
	  "exec": "swaync-client -swb",
	  "on-click": "swaync-client -t -sw",
	  "on-click-right": "swaync-client -d -sw",
	  "escape": true
	},
	"custom/amd-gpu": {
	  "exec": "~/.config/waybar/scripts/amd-gpu.sh gpu",
	  "return-type": "json",
	  "interval": 2,
	  "format": "{}",
	  "tooltip": true
	},
	"custom/amd-vram": {
	  "exec": "~/.config/waybar/scripts/amd-gpu.sh vram",
	  "return-type": "json",
	  "interval": 2,
	  "format": "{}",
	  "tooltip": true
	},
	"custom/workspace-group-1": {
	  "exec": "~/.config/waybar/scripts/workspace-group.sh 1",
	  "return-type": "json",
	  "interval": 1,
	  "signal": 8,
	  "format": "{}",
	  "on-click": "~/.config/hypr/scripts/workspace-group.sh 1",
	  "tooltip": true
	},
	"custom/workspace-group-2": {
	  "exec": "~/.config/waybar/scripts/workspace-group.sh 2",
	  "return-type": "json",
	  "interval": 1,
	  "signal": 8,
	  "format": "{}",
	  "on-click": "~/.config/hypr/scripts/workspace-group.sh 2",
	  "tooltip": true
	},
	"custom/workspace-group-3": {
	  "exec": "~/.config/waybar/scripts/workspace-group.sh 3",
	  "return-type": "json",
	  "interval": 1,
	  "signal": 8,
	  "format": "{}",
	  "on-click": "~/.config/hypr/scripts/workspace-group.sh 3",
	  "tooltip": true
	}
  }
]
