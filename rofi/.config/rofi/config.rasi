configuration {
    modi: "drun,run,window";
    matching: "fuzzy";
    sort: true;
    tokenize: true;
    show-icons: true;
    case-sensitive: false;
    font: "FiraCode Nerd Font 11";
    icon-theme: "Papirus";
    display-drun: "Apps";
    display-run: "Run";
    drun-display-format: "{name}";
    disable-history: false;
    cycle: true;
    hover-select: true;
    window-format: "{w} · {c} · {t}";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    bg:         #0a0e14;
    bg-alt:     #11151c;
    fg:         #b3b1ad;
    fg-muted:   #5c6773;
    sel:        #1f2430;
    sel-text:   #e6e1cf;
}

window {
    width: 680px;
    location: north;
    anchor: north;
    y-offset: 32px;
    border: 2px;
    border-color: #ffb454;
    border-radius: 14px;
    background-color: @bg;
}

mainbox {
    background-color: @bg;
    padding: 12px;
    spacing: 8px;
    children: [ "inputbar", "listview", "message" ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 12px 14px;
    margin: 0px 0px 10px 0px;
}

prompt {
    text-color: @fg-muted;
}

entry {
    text-color: @fg;
}

num-filtered-rows {
    text-color: @fg-muted;
}

textbox-prompt-colon {
    text-color: @fg-muted;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 6px;
    scrollbar: false;
    fixed-height: true;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 10px;
    padding: 10px 12px;
}

element-icon {
    background-color: transparent;
    size: 22px;
    margin: 0px 12px 0px 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

/* normal rows */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

/* selected row */
element selected.normal,
element selected.active,
element selected.urgent,
element alternate.selected {
    background-color: @sel;
    text-color: @sel-text;
}

/* active/urgent rows if they appear */
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @fg;
}

message {
    background-color: transparent;
    margin: 6px 2px 0px 2px;
}

textbox {
    text-color: @fg-muted;
    background-color: transparent;
}
