// -*- mode: jsonc -*-
[
  {
    "output": ["DP-1", "DP-2"],
    "height": 32,
    "spacing": 10,

    "modules-left": [
      "cpu",
      "temperature",
      "memory"
    ],
    "modules-center": [
      "clock"
      
    ],
    "modules-right": [
      "custom/hyprwhspr",
      "pulseaudio",
      "tray"
          ],

    "tray": {
      "icon-size": 14,
      "spacing": 10
    },

    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%I:%M %p  ·  %a %b %d}",
      "format-alt": "{:%Y-%m-%d}"
    },

    "cpu": {
      "format": "{usage}% ",
      "tooltip": true
    },

    "memory": {
      "format": "{}% "
    },

    "temperature": {
      "critical-threshold": 80,
      "format": "{temperatureC}°C {icon}",
      "format-icons": ["", "", ""]
    },

    "pulseaudio": {
      "format": " {volume}% {icon} ",
      "format-muted": " muted",
      "format-icons": {
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol",
      "scroll-step": 5
    },
	"custom/hyprwhspr": {
	  "exec": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh status",
	  "interval": 2,
	  "return-type": "json",
	  "exec-on-event": true,
	  "format": "{}",
	  "on-click": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh toggle",
	  "on-click-right": "/usr/lib/hyprwhspr/config/hyprland/hyprwhspr-tray.sh restart",
	  "tooltip": true
	}
  }
]
