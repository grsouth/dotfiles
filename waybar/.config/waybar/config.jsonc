// -*- mode: jsonc -*-
[
  {
    "output": ["eDP-1"],
    "height": 34,
    "spacing": 10,

    "modules-left": [
      "cpu",
      "temperature",
      "memory"
    ],
    "modules-center": [
      "clock"
      
    ],
    "modules-right": [
      
      "tray",
      "network",
      "battery",
      "pulseaudio"
          ],

    "tray": {
      "icon-size": 14,
      "spacing": 10
    },

    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": "{:%I:%M %p  ·  %a %b %d}",
      "format-alt": "{:%Y-%m-%d}"
    },

    "cpu": {
      "format": "{usage}% ",
      "tooltip": true
    },

    "memory": {
      "format": "{}% "
    },

    "temperature": {
      "critical-threshold": 80,
      "format": "{temperatureC}°C {icon}",
      "format-icons": ["", "", ""]
    },

    "pulseaudio": {
      "format": " {volume}% {icon} ",
      "format-muted": " muted",
      "format-icons": {
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol",
      "scroll-step": 5
    },

    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{capacity}% {icon} ",
      "format-charging": "{capacity}% ",
      "format-plugged": "{capacity}% ",
      "format-alt": "{time} {icon}",
      "format-icons": ["", "", "", "", ""]
    },

    "network": {
      "format-wifi": "{essid} ({signalStrength}%)  ",
      "format-ethernet": "{ipaddr}/{cidr} ",
      "tooltip-format": "{ifname} via {gwaddr} ",
      "format-linked": "{ifname} (No IP) ",
      "format-disconnected": "Disconnected ⚠",
      "format-alt": "{ifname}: {ipaddr}/{cidr}"
    }
  }
]
